</figure>
</figure>

<figure>
<figure>
<%= image_tag 'data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 50"><rect x="0" y="0" width="100" height="50" fill="hsl(212 100% 44%)"/></svg>' %>
