{
	"name": "@remino/dress.css",
	"version": "5.3.0",
	"description": "The little dress of CSS",
	"type": "module",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"scripts": {
		"deploy": "rsdeploy -w",
		"deploy:dryrun": "rsdeploy -n",
		"dev": "astro dev",
		"build": "npm run build:css && npm run build:site",
		"build:commit": "scripts/commit-build.sh",
		"build:css": "vite build",
		"build:site": "astro build",
		"preview": "astro preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "npm run test:visual",
		"test:visual": "playwright test",
		"test:visual:ui": "playwright test --ui",
		"test:visual:update": "playwright test --update-snapshots",
		"test:responses": "bin/test-responses",
		"worktree:init": "bash ./scripts/init-deploy-worktree.sh",
		"prepare": "husky"
	},
	"files": [
		"dist/dress.css",
		"dist/layers"
	],
	"exports": {
		".": "./dist/dress.css",
		"./dress.css": "./dist/dress.css",
		"./layers/variables.css": "./dist/layers/variables.css",
		"./layers/base.css": "./dist/layers/base.css",
		"./layers/props.css": "./dist/layers/props.css",
		"./layers/inlines.css": "./dist/layers/inlines.css",
		"./layers/focus.css": "./dist/layers/focus.css",
		"./layers/links.css": "./dist/layers/links.css",
		"./layers/blocks.css": "./dist/layers/blocks.css",
		"./layers/sections.css": "./dist/layers/sections.css",
		"./layers/headings.css": "./dist/layers/headings.css",
		"./layers/images.css": "./dist/layers/images.css",
		"./layers/lists.css": "./dist/layers/lists.css",
		"./layers/tables.css": "./dist/layers/tables.css",
		"./layers/forms.css": "./dist/layers/forms.css",
		"./layers/code.css": "./dist/layers/code.css",
		"./layers/animation.css": "./dist/layers/animation.css",
		"./layers/popups.css": "./dist/layers/popups.css",
		"./layers/print.css": "./dist/layers/print.css"
	},
	"keywords": [
		"css",
		"boilerplate"
	],
	"homepage": "https://remino.net/dress.css/",
	"license": "ISC",
	"dependencies": {
		"@codemirror/lang-html": "^6.4.9",
		"@codemirror/state": "^6.4.1",
		"@remino/reslib": "git+https://github.com/remino/reslib.git#v0.3.34",
		"codemirror": "^6.0.1",
		"ejs": "^3.1.10",
		"glob": "^11.0.3",
		"rehype-external-links": "^3.0.0",
		"thememirror": "^2.0.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.5",
		"@awmottaz/prettier-plugin-void-html": "^1.9.0",
		"@eslint/js": "^9.10.0",
		"@playwright/test": "^1.49.1",
		"@types/node": "^22.7.4",
		"@typescript-eslint/eslint-plugin": "^8.8.1",
		"@typescript-eslint/parser": "^8.8.1",
		"astro": "^5.0.0",
		"astro-compress": "^2.3.8",
		"astro-compressor": "^1.2.0",
		"cssnano": "^7.1.2",
		"eslint": "^9.10.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-astro": "^1.3.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-jsx-a11y": "^6.10.0",
		"eslint-plugin-prettier": "^5.2.1",
		"fast-glob": "^3.3.1",
		"globals": "^15.5.0",
		"husky": "^9.1.7",
		"postcss": "^8.5.6",
		"postcss-replace": "^2.0.1",
		"prettier": "^3.3.3",
		"prettier-plugin-astro": "^0.14.0",
		"remark-custom-heading-id": "^2.0.0",
		"remark-deflist": "^1.0.0",
		"remark-toc": "^9.0.0",
		"typescript": "^5.6.2",
		"typescript-eslint": "^8.8.1",
		"unist-util-visit": "^5.0.0",
		"vite": "^5.4.8"
	}
}
