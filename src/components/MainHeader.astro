---
import HeaderNav from './HeaderNav.astro'
import logoUrl from '../images/dress.svg?url'

interface NavItem {
	label: string
	href: string
	external?: boolean
}

interface Props {
	navItems: NavItem[]
	siteTitle: string
}

const { navItems, siteTitle } = Astro.props as Props
---

<header>
	<h1>
		<img src={logoUrl} alt="" role="presentation" />{siteTitle}
	</h1>
	<HeaderNav items={navItems} />
</header>
