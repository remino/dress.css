---
import HeaderNav from './HeaderNav.astro'
import logoUrl from '../images/dress.svg?url'
import { siteConfig } from '../config/site.ts'

interface NavItem {
	label: string
	href: string
	external?: boolean
}

interface Props {
	navItems: NavItem[]
	siteTitle: string
}

const { navItems, siteTitle } = Astro.props as Props

const topPageUrl = `/${siteConfig.prefix}/`
---

<header>
	<h1>
		<a href={topPageUrl}>
			<img src={logoUrl} alt="" role="presentation" width="64" height="64" />{
				siteTitle
			}
		</a>
	</h1>
	<HeaderNav items={navItems} />
</header>
