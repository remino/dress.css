<% ['dresscss', 'semcss', 'sem.css'].forEach(alias => { %>
location = /<%= alias %> {
	return 301 /dress.css/;
}

location /<%= alias %>/ {
	rewrite ^/<%= alias.replace('.', '\\.') %>/(.*) /dress.css/$1 permanent;
}
<% }); %>
<% if (shareImage) { %>
location = /dress.css/share.png {
	return 301 <%= shareImage %>;
}
<% } %>
location = /dress.css/demo {
	return 301 /dress.css/specimen/;
}

location /dress.css/demo/ {
	rewrite ^/dress\.css/demo/(.*) /dress.css/specimen/$1 permanent;
}
