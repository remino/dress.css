---
import BaseLayout from './BaseLayout.astro'
import MainHeader from '../components/MainHeader.astro'
import MainFooter from '../components/MainFooter.astro'
import { siteConfig } from '../config/site.ts'
import docsScript from '../scripts/docs.ts?url'

interface Props {
	title?: string
	description?: string
	image?: string
	pathname?: string
	includeDocsScript?: boolean
}

type FrontmatterProps = Props & {
	frontmatter?: Partial<Props>
}

const props = Astro.props as FrontmatterProps
const frontmatter = props.frontmatter ?? {}

const title = props.title ?? frontmatter.title
const description = props.description ?? frontmatter.description
const image = props.image ?? frontmatter.image
const pathname = props.pathname
const includeDocsScript =
	props.includeDocsScript ?? frontmatter.includeDocsScript ?? true

const navItems = [
	{ label: 'Home', href: '/dress.css/' },
	{ label: 'Updates', href: '/dress.css/updates/' },
	{ label: 'Elements', href: '/dress.css/elements/' },
	{ label: 'Demo', href: '/dress.css/demo/' },
	{ label: 'Playground', href: '/dress.css/playground/' },
	{
		label: 'Variables',
		href: '/dress.css/variables/',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/remino/dress.css',
		external: true,
	},
	{
		label: 'npm',
		href: 'https://www.npmjs.com/package/@remino/dress.css',
		external: true,
	},
]
---

<BaseLayout {title} {description} {image} {pathname}>
	{includeDocsScript && <script slot="head" type="module" src={docsScript} />}
	<slot slot="head" name="head" />

	<a href="#main">Skip to main content</a>
	<MainHeader {navItems} siteTitle={siteConfig.title} />
	<main id="main">
		<slot />
	</main>
	<MainFooter />
</BaseLayout>
