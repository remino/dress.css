---
import '../dress.css'
import '../styles/docs.css'
import { siteConfig } from '../config/site.ts'
import logoUrl from '../images/dress.svg?url'

interface Props {
	title?: string
	description?: string
	image?: string
	pathname?: string
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
	image = siteConfig.image,
	pathname = Astro.url.pathname,
} = Astro.props as Props

const titleSegments: string[] = []

if (title && title !== siteConfig.title) {
	titleSegments.push(title)
} else if (siteConfig.title) {
	titleSegments.push(siteConfig.title)
}

if (
	siteConfig.title &&
	titleSegments[titleSegments.length - 1] !== siteConfig.title
) {
	titleSegments.push(siteConfig.title)
}

if (siteConfig.publisher) {
	titleSegments.push(siteConfig.publisher)
}

const pageTitle = titleSegments.filter(Boolean).join(' : ')
const canonicalUrl = new URL(pathname.replace(/\/+/g, '/'), siteConfig.url)
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="viewport-fit=cover, width=device-width, initial-scale=1"
		/>
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonicalUrl} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL(image, siteConfig.url)} />
		<meta property="og:image:width" content="2880" />
		<meta property="og:image:height" content="1440" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={siteConfig.twitter} />
		<meta name="twitter:creator" content={siteConfig.twitter} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, siteConfig.url)} />
		<meta name="twitter:url" content={canonicalUrl} />
		<link rel="icon" type="image/png" href="/dress.css/favicon.png" />
		<link rel="icon" type="image/svg+xml" href={logoUrl} />
		<link rel="apple-touch-icon" href="/dress.css/apple-touch-icon.png" />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
