---
import dressCssUrl from '../dress.css?url'
import testCssUrl from '../styles/test.css?url'
const { title = 'dress.css test' } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link rel="stylesheet" href={dressCssUrl} />
		<link rel="stylesheet" href={testCssUrl} />
	</head>
	<body>
		<slot />
	</body>
</html>
