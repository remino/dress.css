---
import BaseLayout from '../layouts/BaseLayout.astro'

const isProd = import.meta.env.PROD
---

<BaseLayout title="dress.css" pathname="/">
	{
		isProd ? (
			<>
				<Fragment slot="head">
					<meta http-equiv="refresh" content="0; url=/dress.css/" />
				</Fragment>
				<main>
					<p>
						Redirecting to <a href="/dress.css/">/dress.css/</a>…
					</p>
				</main>
			</>
		) : (
			<main>
				<h1>dress.css</h1>
				<p>
					<a href="/dress.css/">Visit the documentation</a>
				</p>
			</main>
		)
	}
</BaseLayout>
