---
import TestMainLayout from '../../../layouts/TestMainLayout.astro'
---

<TestMainLayout title="Nestedfigures">
<figure>
	<figure>
		<img src='data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 200"><rect x="0" y="0" width="600" height="200" fill="hsl(300 100.0% 50.0%"/></svg>'>
		<figcaption>Wide Fuchsia</figcaption>
	</figure>
</figure>

<figure>
	<figure>
		<img src='data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 50"><rect x="0" y="0" width="100" height="50" fill="hsl(212 100% 44%)"/></svg>'>
		<figcaption>Blue</figcaption>
	</figure>
	<figure>
		<img src='data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 50"><rect x="0" y="0" width="100" height="50" fill="hsl(320 100% 64%)"/></svg>'>
		<figcaption>Pink</figcaption>
	</figure>
	<figure>
		<img src='data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 50"><rect x="0" y="0" width="100" height="50" fill="hsl(270 100% 64%)"/></svg>'>
		<figcaption>Purple</figcaption>
	</figure>
	<figcaption>A set of electric colours.</figcaption>
</figure>
</TestMainLayout>
