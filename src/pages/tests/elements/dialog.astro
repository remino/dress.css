---
import TestMainLayout from '../../../layouts/TestMainLayout.astro'
---

<TestMainLayout title="Dialog">
	<style is:inline>
		body {
			background: var(--dress-bg-2);
		}
	</style>

	<dialog id="dialogExample">
		<form method="dialog">
			<h1>Hello!</h1>
			<p>This is a native dialog.</p>
			<menu>
				<li><button value="cancel" autofocus>Cancel</button></li>
				<li><button type="submit" value="ok">OK</button></li>
			</menu>
		</form>
	</dialog>

	<script is:inline>
		document.getElementById('dialogExample').showModal()
	</script>
</TestMainLayout>
