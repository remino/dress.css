---
import TestMainLayout from '../../../layouts/TestMainLayout.astro'
---

<TestMainLayout title="Input">
	<nav>
		<form method="post">
			<label>
				<span>Search</span>
				<input type="search" />
			</label>
		</form>
	</nav>
	<form method="post">
		<label>
			<span>Username</span>
			<input />
		</label>
		<label>
			<span>Password</span>
			<input type="password" />
			<small>Must be at least 12 characters.</small>
		</label>
		<label>
			<span>Email</span>
			<input type="email" />
		</label>
		<label>
			<span>Age</span>
			<input type="number" />
		</label>
		<label>
			<span>Phone</span>
			<input type="tel" />
		</label>
		<label>
			<span>Homepage</span>
			<input type="url" />
		</label>
	</form>
</TestMainLayout>
