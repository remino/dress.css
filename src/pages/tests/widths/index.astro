---
import TestBodyLayout from '../../../layouts/TestBodyLayout.astro'
---

<TestBodyLayout title="Index">
	<style>
		:root {
			--dress-mw: 100%;
		}
		body {
			align-content: center;
			align-items: center;
			background: var(--dress-bg);
			block-size: max-content;
			display: grid;
			gap: var(--dress-p-b);
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 1fr 1fr;
			inline-size: max-content;
			justify-content: center;
			margin: 0 auto;
			min-block-size: 0;
		}
		iframe {
			align-items: center;
			block-size: 400px;
			border: solid 1px var(--dress-bg);
			display: flex;
			font-size: 1.5rem;
			inline-size: 400px;
			justify-content: center;
			margin-block: 0;
		}
		html {
			align-content: center;
			block-size: 100vh;
			inline-size: 100vw;
		}
	</style>

	<iframe src="full-width/"></iframe>
	<iframe src="max-width/"></iframe>
	<iframe src="min-width/"></iframe>
	<iframe src="most-narrow/"></iframe>
</TestBodyLayout>
