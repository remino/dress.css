---
import TestMainLayout from '../../../layouts/TestMainLayout.astro'
---

<TestMainLayout title="Most Narrow">
	<style is:inline>
		:root {
			--dress-bg-2: transparent;
			--dress-dt: transparent;
			--dress-mw-min: 0;
		}

		body {
			background-color: var(--dress-fg);
		}

		h1 {
			background: var(--dress-fg);
			color: var(--dress-bg);
		}

		main {
			background: var(--dress-bg);
		}
	</style>

	<h1>most-narrow</h1>
</TestMainLayout>
