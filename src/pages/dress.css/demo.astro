	<h2>Sign Up for our Newsletter!</h2>

	<p>Get all the lorem ipsum in your inbox.</p>

	<p>
		<mark><strong>Note</strong></mark> This form is only a demonstration and does
		not send any data. The submit button is only enabled when all required fields
		are filled out correctly.
	</p>

	<form id="signup" method="post" data-nosubmit>
		<label>
			<span
			>Full Name <small><mark><strong>required</strong></mark></small></span
			>
			<input type="text" placeholder="Given Name" required />
			<input type="text" placeholder="Family Name" required />
		</label>

		<label>
			<span>Email <small><mark><strong>required</strong></mark></small></span>
			<input type="email" placeholder="name@example.com" required />
			<small>Please ensure your email address is correct.</small>
		</label>

		<label>
			<span>Country of Residence</span>
			<select>
				<option>Canada</option>
				<option>China</option>
				<option>France</option>
				<option>Germany</option>
				<option>Italy</option>
				<option>Japan</option>
				<option>Mexico</option>
				<option>South Korea</option>
				<option>United Kingdom</option>
				<option>United States</option>
				<option>Other</option>
			</select>
		</label>

		<fieldset>
			<legend>Select Topics</legend>
			<label>
				<input type="checkbox" name="topics" value="news" />
				<span>General News</span>
			</label>
			<label>
				<input type="checkbox" name="topics" value="tech" />
				<span>Tech</span>
			</label>
			<label>
				<input type="checkbox" name="topics" value="fashion" />
				<span>Fashion</span>
			</label>
			<label>
				<input type="checkbox" name="topics" value="photo" />
				<span>Photography</span>
			</label>
			<label>
				<input type="checkbox" name="topics" value="politics" disabled />
				<span>Politics</span>
			</label>
		</fieldset>

		<fieldset>
			<legend>Format</legend>
			<label>
				<input type="radio" name="format" value="html" />
				<span>HTML</span>
			</label>
			<label>
				<input type="radio" name="format" value="plain" />
				<span>Plain Text</span>
			</label>
			<label>
				<input type="radio" name="format" value="pdf" disabled />
				<span>PDF</span>
			</label>
		</fieldset>

		<label>
			<span>Feedback</span>
			<textarea rows="4"></textarea>
		</label>

		<label>
			<span>Favourite Colour</span>
			<input type="color" value="#6699ff" />
		</label>

		<label>
			<span>How likely are you to recommend us?</span>
			<input type="range" min="0" max="10" value="7" />
		</label>

		<label>
			<span>Upload a reference image</span>
			<input type="file" />
		</label>

		<label>
			<span>How many newsletters per month?</span>
			<input type="number" min="1" max="10" value="3" />
		</label>

		<label>
			<span>Preferred meeting time</span>
			<input type="time" value="13:30" />
		</label>

		<label>
			<span>Preferred contact date</span>
			<input type="date" />
		</label>

		<label>
			<span>Preferred contact datetime</span>
			<input type="datetime-local" />
		</label>

		<menu>
			<li><button type="submit">Subscribe</button></li>
			<li><button type="reset">Reset</button></li>
		</menu>
	</form>
</PageLayout>
