---
import PageLayout from '../../layouts/PageLayout.astro'
import '../../styles/playground.css'

const title = 'Playground'
const initialMarkup = String.raw`<playground-app>
<h1>Hello!</h1>
<p>Edit me!</p>
</playground-app>`
---

<PageLayout title={title} pathname="/dress.css/playground/">
	<h1>{title}</h1>
	<!-- prettier-ignore -->
	<template data-type="init" set:html={initialMarkup}></template>
	<script src="../../scripts/playground.ts"></script>
</PageLayout>
