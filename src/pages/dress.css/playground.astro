---
import PageLayout from '../../layouts/PageLayout.astro'
import '../../styles/playground.css'
import playgroundScript from '../../scripts/playground.ts?url'
import sampleHTML from '../../playground/sample.html?raw'

const title = 'Playground'
---

<PageLayout title={title} pathname="/dress.css/playground/">
	<script slot="head" type="module" src={playgroundScript}></script>

	<h1>{title}</h1>

	<playground-app set:html={sampleHTML} />
</PageLayout>
